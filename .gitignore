crashlytics-build.properties

#! Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

#! Addressables 플랫폼별 빌드 스냅샷 폴더 (content_state.bin 보관용 — 내용물은 위에서 이미 제외)
/Assets/AddressableAssetsData/Android/
/Assets/AddressableAssetsData/Android.meta
/Assets/AddressableAssetsData/Windows/
/Assets/AddressableAssetsData/Windows.meta

#! realvirtual MCP 도구가 상시 갱신하는 상태 파일 — 작업 트리 노이즈 방지
/Assets/StreamingAssets/realvirtual-MCP
/Assets/StreamingAssets/realvirtual-MCP.meta

#! 밸런스 JSON 정본은 Assets/_Lair/Data/Json — StreamingAssets 사본은 빌드훅(BalanceJsonBuildCopier) 산출물이라 미추적
/Assets/StreamingAssets/balance_config.json
/Assets/StreamingAssets/balance_config.json.meta

#! Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

#! Android IL2CPP/CMake 빌드 임시 산출물
/.utmp/

#! realvirtual MCP 도구 런타임 흔적 (외부 도구 — 게임 빌드 무관)
/[Aa]ssets/[Ss]treamingAssets/realvirtual-MCP
